// YENİ EKLENEN TOOLTİPLER (KALKAN VE HYBRID İÇİN)
// =============================================================================
string TT_KALKAN_TR  = "🛡️ Trend Filtresi: Fiyatın genel yönüne ters düşen sahte uyumsuzlukları engeller.\n\n• AÇIK: Fiyat ortalamanın üzerindeyse sadece Boğa, altındaysa sadece Ayı sinyallerine izin verir.\n• KAPALI: Trende bakmaksızın tüm uyumsuzlukları çizer."
string TT_KALKAN_VOL = "⚡ Volatilite (Lastik) Sensörü: Fiyatın ortalamadan ne kadar saptığını ölçer.\n\nTrend tersi olsa bile, fiyat Bollinger dışına taştıysa (aşırı ucuz/pahalı) sistem 'Buradan tepki/dönüş gelebilir' der ve uyumsuzluk sinyaline İZİN VERİR."
string TT_AUTO_ATR   = "ATR, kendi ortalamasının belirlenen çarpan kadar üstüne çıkarsa piyasa 'Kaotik' kabul edilir ve iğneler yerine otomatik olarak Kapanış (Close) fiyatları baz alınır."
string TT_AUTO_BB    = "Bollinger bant genişliği, kendi ortalamasını aşarsa piyasada 'Patlama' var kabul edilir ve sahte iğnelere aldanmamak için Kapanış (Close) fiyatlarına geçilir."

// =============================================================================
// 🧠 ADAPTIVE PERIOD ENGINE - FONKSİYONLAR
// =============================================================================
f_get_base_macd_periods() =>
    if timeframe.isminutes and timeframe.multiplier <= 5
        [12, 26, 9]
    else if timeframe.isminutes and timeframe.multiplier <= 15
        [12, 26, 9]
    else if timeframe.isminutes and timeframe.multiplier <= 60
        [16, 34, 12]
    else if timeframe.isminutes
        [20, 40, 15]
    else if timeframe.isdaily
        [12, 26, 9]
    else if timeframe.isweekly
        [12, 26, 9]
    else if timeframe.ismonthly
        [12, 26, 9]
    else
        [12, 26, 9]

f_get_volatility_multiplier(simple int atr_len, simple int atr_sma_len, simple float sensitivity) =>
    float atr_current = ta.atr(atr_len)
    float atr_avg = ta.sma(ta.atr(atr_len), atr_sma_len)
    float vol_ratio = atr_current / atr_avg
    float base_mult = vol_ratio > 1.5 ? 1.4 : vol_ratio > 1.2 ? 1.2 : vol_ratio > 0.8 ? 1.0 : vol_ratio > 0.5 ? 0.85 : 0.7
    1.0 + (base_mult - 1.0) * sensitivity

f_get_volume_multiplier(simple int vol_sma_len, simple float sensitivity) =>
    float vol_current = volume
    float vol_avg = ta.sma(volume, vol_sma_len)
    float vol_ratio = vol_current / vol_avg
    float base_mult = vol_ratio > 2.0 ? 0.85 : vol_ratio > 1.5 ? 0.92 : vol_ratio > 0.7 ? 1.0 : vol_ratio > 0.4 ? 1.1 : 1.2
    1.0 + (base_mult - 1.0) * sensitivity

f_get_trend_strength_multiplier(simple int adx_len) =>
    [diPlus, diMinus, adx_value] = ta.dmi(adx_len, adx_len)
    adx_value > 40 ? 1.3 : adx_value > 25 ? 1.15 : adx_value > 20 ? 1.0 : adx_value > 15 ? 0.9 : 0.8

f_get_market_regime_multiplier() =>
    float ema_200 = ta.ema(close, 200)
    float ema_50 = ta.ema(close, 50)
    if close > ema_200 and ema_50 > ema_200
        0.85  
    else if close < ema_200 and ema_50 < ema_200
        1.2   
    else
        1.4   

f_ema(src, length) =>
    alpha = 2.0 / (length + 1)
    var float ema = na
    ema := na(ema) ? src : alpha * src + (1 - alpha) * ema[1]
    ema

f_sma(src, length) =>
    float sum = 0.0
    for i = 0 to length - 1
        sum += src[i]
    sum / length

